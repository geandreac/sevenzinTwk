<Window x:Class="Sevenzin.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sevenzin Program" Height="760" Width="1280" MinWidth="980" MinHeight="620"
        Icon="pack://application:,,,/Assets/sevenzin.ico"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}"
        FontFamily="{StaticResource UiFont}" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar estreita (Figma 3:950, 66px, só ícones). Largura animável ao expandir/recolher. -->
        <Border x:Name="Sidebar" Width="66" Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Viewbox Height="22" HorizontalAlignment="Center" Margin="0,16,0,8">
                        <Path Data="{StaticResource ic_logo}" Fill="{StaticResource Brand500Brush}"/>
                    </Viewbox>
                    <Button x:Name="MenuBtn" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="Menu_Click" ToolTip="Expandir/recolher menu" AutomationProperties.Name="Expandir ou recolher o menu">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="mb" Background="Transparent">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource ic_menu}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="mb" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <Ellipse DockPanel.Dock="Bottom" Width="8" Height="8" Margin="0,0,0,18" HorizontalAlignment="Center"
                         Fill="{StaticResource SuccessBrush}" ToolTip="Monitorando · local"/>
                <ListBox x:Name="Nav" Style="{StaticResource NavLista}" Margin="0,8,0,0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeButton}" Click="Min_Click" ToolTip="Minimizar">
                        <Path Data="M0,0 H11" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource ChromeButton}" Click="Max_Click" ToolTip="Maximizar">
                        <Rectangle Width="10.5" Height="10.5" RadiusX="2" RadiusY="2"
                                   Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Fechar">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="UsuarioLabel" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="SairBtn" Content="Sair" Click="Sair_Click" Cursor="Hand"
                            Foreground="{StaticResource TextSecondaryBrush}" Background="Transparent" FontFamily="{StaticResource UiFont}" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="sb" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="7" Padding="12,5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="sb" Property="Background" Value="{StaticResource Surface3Brush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TituloBarra" Text="Início" Margin="24,0,0,0" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <ContentControl x:Name="Host" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
