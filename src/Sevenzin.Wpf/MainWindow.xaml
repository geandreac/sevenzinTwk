<Window x:Class="Sevenzin.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sevenzin.Wpf"
        Title="SevenzinTwks" Height="760" Width="1280" MinWidth="980" MinHeight="620"
        Icon="pack://application:,,,/Assets/sevenzin.ico"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}"
        FontFamily="{StaticResource UiFont}" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar estreita (69px = 68px internos + 1px divisória, ícones 100% centralizados em células 48×40). -->
        <Border x:Name="Sidebar" Width="69" Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,0,1,0" UseLayoutRounding="True">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="{StaticResource LogoSimbolo}" Height="22" HorizontalAlignment="Center" Margin="0,16,0,10"
                           RenderOptions.BitmapScalingMode="HighQuality" ToolTip="SevenzinTwks" AutomationProperties.Name="SevenzinTwks"/>
                    <Button x:Name="MenuBtn" Height="40" Margin="10,2" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="Menu_Click" ToolTip="Expandir/recolher menu" AutomationProperties.Name="Expandir ou recolher o menu">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Border x:Name="mb" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Opacity="0"/>
                                    <Grid Width="48" Height="40" HorizontalAlignment="Left">
                                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="mp" Data="{StaticResource ic_menu}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                    </Grid>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="mp" Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="mb" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="mb" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <!-- Status: área própria, separada da navegação por uma divisória; o DockPanel reserva este
                     bloco, então a lista nunca o sobrepõe nem é sobreposta por ele (com ou sem rolagem). -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,14">
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Center"
                             Fill="{StaticResource SuccessBrush}" ToolTip="Monitorando · local"/>
                </Border>
                <ListBox x:Name="Nav" Style="{StaticResource NavLista}" Margin="0,8,0,4"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeButton}" Click="Min_Click" ToolTip="Minimizar">
                        <Path Data="M0,0 H11"/>
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource ChromeButton}" Click="Max_Click" ToolTip="Maximizar">
                        <Rectangle Width="10.5" Height="10.5" RadiusX="2" RadiusY="2"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Fechar">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"/>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="AvisoAtualizaBtn" Visibility="Collapsed" Click="IrParaAtualizacao_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Margin="0,0,12,0" VerticalAlignment="Center"
                            ToolTip="Baixar a nova versão, instalar e reabrir o app" Tag="Reiniciar para atualizar" AutomationProperties.Name="Atualização disponível">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{TemplateBinding Tag}" Margin="6,0,0,0" FontSize="12"
                                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="UsuarioLabel" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="SairBtn" Content="Sair" Click="Sair_Click" Cursor="Hand"
                            Foreground="{StaticResource TextSecondaryBrush}" Background="Transparent" FontFamily="{StaticResource UiFont}" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="sb" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="7" Padding="12,5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="sb" Property="Background" Value="{StaticResource Surface3Brush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <Border/>
            </DockPanel>
            <ContentControl x:Name="Host" Grid.Row="1"/>
        </Grid>

        <!-- Toasts: overlay no canto superior direito, sobre tudo, sem deslocar o layout -->
        <local:ToastHost x:Name="ToastHostPanel" Grid.ColumnSpan="2" Panel.ZIndex="100"/>
    </Grid>
</Window>
