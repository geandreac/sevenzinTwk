<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sevenzin</AssemblyName>
    <RootNamespace>Sevenzin.Wpf</RootNamespace>
    <AssemblyTitle>SevenzinTwks</AssemblyTitle>
    <Version>2.1.0</Version>
    <ApplicationIcon>Assets\sevenzin.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Servidor de contas embutido no executável (lido das variáveis de ambiente da máquina que gera o build; não vai
       para o código-fonte). Sem isto, o app instalado em outro PC não acha o servidor e cai no modo de contas locais. -->
  <ItemGroup Condition="'$(SEVENZIN_SUPABASE_URL)' != '' and '$(SEVENZIN_SUPABASE_ANON)' != ''">
    <AssemblyMetadata Include="SEVENZIN_SUPABASE_URL" Value="$(SEVENZIN_SUPABASE_URL)" />
    <AssemblyMetadata Include="SEVENZIN_SUPABASE_ANON" Value="$(SEVENZIN_SUPABASE_ANON)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="..\Sevenzin.Diagnostics\Sevenzin.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\sevenzin.ico" />
    <Resource Include="Assets\Apps\*.png" />
  </ItemGroup>

</Project>
