<UserControl x:Class="Sevenzin.Wpf.Views.LimpezaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="SISTEMA" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Limpeza" Style="{StaticResource TituloTela}" Margin="0,2,0,2"/>
            <TextBlock Text="Remove temporários e caches. Nenhum arquivo pessoal. Limpar envia para a Lixeira (recuperável); só esvaziar a Lixeira é permanente."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Border x:Name="ResumoPill" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,16">
                <TextBlock x:Name="ResumoTxt" FontWeight="SemiBold" FontSize="13" Text="Clique em Analisar para medir o que pode ser limpo."/>
            </Border>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,8">
            <StackPanel x:Name="Lista"/>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,16">
            <Button x:Name="AnalisarBtn" Style="{StaticResource PrimaryButton}" Content="Analisar" Padding="14,8" Margin="0,0,10,0" Click="Analisar_Click"/>
            <Button x:Name="LimparBtn" Style="{StaticResource PrimaryButton}" Background="{StaticResource SuccessBrush}" Content="Limpeza Total" Padding="14,8" Margin="0,0,10,0" Click="Limpar_Click" IsEnabled="False"/>
            <Button x:Name="AdminBtn" Style="{StaticResource SecondaryButton}" Content="Reabrir como administrador" Padding="14,8" Click="Admin_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
