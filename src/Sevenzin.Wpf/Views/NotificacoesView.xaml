<UserControl x:Class="Sevenzin.Wpf.Views.NotificacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,8,0,12">
            <TextBlock Text="ATIVIDADE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Notificações" Style="{StaticResource TituloTela}"/>
            <TextBlock Text="Histórico local do que o Sevenzin fez nesta máquina: tweaks, instalações e capturas. Nada sai do PC." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <Button Style="{StaticResource SecondaryButton}" Content="Limpar histórico" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Limpar_Click"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
            <StackPanel x:Name="Lista"/>
        </ScrollViewer>
    </Grid>
</UserControl>
