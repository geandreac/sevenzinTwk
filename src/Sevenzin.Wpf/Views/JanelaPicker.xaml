<Window x:Class="Sevenzin.Wpf.Views.JanelaPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher janela" Width="440" Height="440"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Surface0Brush}"
        FontFamily="{StaticResource FontBody}" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Escolha a janela para capturar" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <ListBox x:Name="Lista" Grid.Row="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}" SelectionChanged="Lista_SelectionChanged"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancelar_Click"/>
            <Button x:Name="BtnOk" Content="Capturar" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
