<Window x:Class="Sevenzin.Wpf.Views.RegiaoOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar região"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="0" Top="0" Background="#66000000"
        AllowsTransparency="True" Cursor="Cross" KeyDown="Janela_KeyDown">
    <Grid>
        <Border x:Name="Selecao" Visibility="Collapsed" BorderBrush="#FF2F8CFF" BorderThickness="1.5"
                Background="#222F8CFF" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock x:Name="Dica" Text="Arraste para selecionar a região · Esc cancela" Foreground="White"
                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                   Background="#99000000" Padding="10,6"/>
    </Grid>
</Window>
