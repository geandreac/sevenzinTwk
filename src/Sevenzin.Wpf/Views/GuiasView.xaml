<UserControl x:Class="Sevenzin.Wpf.Views.GuiasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,8,0,12">
            <TextBlock Text="APRENDA" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Guias" Style="{StaticResource TituloTela}"/>
            <TextBlock Text="Como usar o Sevenzin do jeito certo: medir, confirmar e desfazer. Cada guia cobre só o que o app realmente faz." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
            <StackPanel x:Name="Lista"/>
        </ScrollViewer>
    </Grid>
</UserControl>
