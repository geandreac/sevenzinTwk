<UserControl x:Class="Sevenzin.Wpf.Views.BiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,8,0,12">
            <TextBlock Text="HARDWARE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="BIOS / UEFI" Style="{StaticResource TituloTela}"/>
            <TextBlock Text="Diagnóstico somente leitura. O Sevenzin NÃO altera BIOS/UEFI, Secure Boot, TPM, ordem de boot, voltagem nem clocks — apenas informa e orienta." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
            <StackPanel x:Name="Raiz"/>
        </ScrollViewer>
    </Grid>
</UserControl>
