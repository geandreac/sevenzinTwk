<UserControl x:Class="Sevenzin.Wpf.Views.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid Margin="44,24,40,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho superior: Título + Subtítulo à esquerda, Status da GPU à direita -->
            <Grid Grid.Row="0" Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="GPU" Style="{StaticResource TituloTela}"/>
                    <TextBlock Text="Ajustes de driver para a sua placa de vídeo."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <Border x:Name="CardStatusTopo" Grid.Column="1"
                        Background="{StaticResource Surface1Brush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="14,10" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtModeloTopo" Text="Detectando GPU..."
                                   FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse x:Name="PontoStatusTopo" Width="8" Height="8"
                                     Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TxtSubstatusTopo"
                                       Text="Verificando adaptadores..."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11.5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Conteúdo rolável -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,12">
                <StackPanel x:Name="Lista"/>
            </ScrollViewer>

        </Grid>

        <!-- Modal sobreposto: Auto NVIDIA Debloat -->
        <Grid x:Name="ModalDebloatOverlay" Visibility="Collapsed" Background="#BE03060C">
            <Border Width="580" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ModalDebloatConteudo"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
