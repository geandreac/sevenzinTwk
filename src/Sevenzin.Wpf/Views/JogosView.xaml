<UserControl x:Class="Sevenzin.Wpf.Views.JogosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,8,0,12">
            <TextBlock Text="Jogos" Style="{StaticResource TituloTela}"/>
            <TextBlock Text="Perfil por jogo: afinidade e prioridade TEMPORÁRIAS, revertidas por você ou ao fechar o jogo. Nunca Realtime. Working set e timer de 1 ms são opt-in com aviso. Meça com Benchmark/Telemetria (A/B) antes de confiar no ganho." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BuscaBox" Style="{StaticResource DarkBox}" Width="260" HorizontalAlignment="Left" TextChanged="Busca_Changed" Tag="Buscar jogo…"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Aplicar ao abrir" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                <ToggleButton x:Name="AutoSwitch" Style="{StaticResource ToggleSwitch}" Click="Auto_Click"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Adicionar jogo" VerticalAlignment="Center" Click="Adicionar_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,8">
            <StackPanel x:Name="Lista"/>
        </ScrollViewer>

        <TextBlock x:Name="StatusLbl" Grid.Row="3" Foreground="{StaticResource TextMutedBrush}" Margin="2,10,0,12"
                   Text="Adicione um jogo (.exe) para criar um perfil reversível."/>
    </Grid>
</UserControl>
