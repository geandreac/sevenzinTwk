<UserControl x:Class="Sevenzin.Wpf.Views.WindowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,8,0,12">
            <TextBlock Text="SISTEMA" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Windows" Style="{StaticResource TituloTela}"/>
            <TextBlock Text="Informações do Windows e recomendações seguras. Toda mudança real é reversível, auditada e confirmada por você — na tela Ajustes. O construtor de ISO/debloat do programa original foi removido por segurança." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
            <StackPanel x:Name="Raiz"/>
        </ScrollViewer>
    </Grid>
</UserControl>
