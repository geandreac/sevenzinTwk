<UserControl x:Class="Sevenzin.Wpf.Views.InstaladoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,8,0,12">
            <TextBlock Text="SOFTWARE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Instaladores" Style="{StaticResource TituloTela}"/>
            <TextBlock Text="Só fontes oficiais. O download é verificado por assinatura (e hash, quando fixado) ANTES de permitir executar. Nada é baixado nem executado sem você — ao contrário do original." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
            <StackPanel x:Name="Lista"/>
        </ScrollViewer>
    </Grid>
</UserControl>
