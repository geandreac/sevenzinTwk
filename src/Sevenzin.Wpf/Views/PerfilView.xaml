<UserControl x:Class="Sevenzin.Wpf.Views.PerfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,8,0,12">
            <TextBlock Text="SUA CONTA" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Perfil" Style="{StaticResource TituloTela}"/>
            <TextBlock Text="Conta local, verificação em dois fatores e licença — tudo no seu PC, sem servidor, sem HWID e sem Discord." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
            <StackPanel x:Name="Lista"/>
        </ScrollViewer>
    </Grid>
</UserControl>
