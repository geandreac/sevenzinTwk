<UserControl x:Class="Sevenzin.Wpf.Views.PerfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Conta local, verificação em dois fatores e licença — tudo no seu PC, sem servidor, sem HWID e sem Discord." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="Lista"/>
    </Grid>
</UserControl>
