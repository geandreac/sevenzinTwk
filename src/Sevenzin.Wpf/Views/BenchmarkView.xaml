<UserControl x:Class="Sevenzin.Wpf.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Benchmark" Style="{StaticResource TituloTela}" Margin="0,8,0,2"/>
            <TextBlock Text="Benchmark de frametime interno e reproduzível: mede uma cena do próprio app (não um jogo externo). Serve para comparar o MESMO PC antes e depois de uma mudança. Sem administrador, sem anti-cheat." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Quadros" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                <TextBox x:Name="QuadBox" Style="{StaticResource DarkBox}" Text="2000" Width="80" Margin="0,0,16,0"/>
                <Button x:Name="BtnRodar" Style="{StaticResource PrimaryButton}" Content="Rodar benchmark" Click="Rodar_Click"/>
                <TextBlock x:Name="StatusLbl" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="16,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,16" VerticalAlignment="Top" ClipToBounds="True">
            <DataGrid x:Name="ResGrid" Style="{StaticResource DarkGrid}" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Métrica" Binding="{Binding Metrica}" Width="1.6*"/>
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
