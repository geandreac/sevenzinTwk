<UserControl x:Class="Sevenzin.Wpf.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sevenzin.Wpf.Views">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Configurações" Style="{StaticResource TituloTela}" Margin="0,8,0,0"/>
            <TextBlock Text="Preferências, conta, notificações, telemetria e benchmark reunidos em um só lugar." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>

            <Grid Margin="0,16,0,22">
                <Border Height="1" Background="{StaticResource BorderDefaultBrush}" VerticalAlignment="Bottom"/>
                <StackPanel x:Name="Abas" Orientation="Horizontal">
                    <RadioButton x:Name="TabGeral" Tag="0" GroupName="AbasConfig" Style="{StaticResource Aba}" Content="Geral" Checked="Tab_Click"/>
                    <RadioButton x:Name="TabPref" Tag="1" GroupName="AbasConfig" Style="{StaticResource Aba}" Content="Preferências" Checked="Tab_Click"/>
                    <RadioButton x:Name="TabPerfil" Tag="2" GroupName="AbasConfig" Style="{StaticResource Aba}" Content="Perfil" Checked="Tab_Click"/>
                    <RadioButton x:Name="TabNotificacoes" Tag="3" GroupName="AbasConfig" Style="{StaticResource Aba}" Content="Notificações" Checked="Tab_Click"/>
                    <RadioButton x:Name="TabTelemetria" Tag="4" GroupName="AbasConfig" Style="{StaticResource Aba}" Content="Telemetria" Checked="Tab_Click"/>
                    <RadioButton x:Name="TabBenchmark" Tag="5" GroupName="AbasConfig" Style="{StaticResource Aba}" Content="Benchmark" Checked="Tab_Click"/>
                </StackPanel>
                <Border x:Name="Sublinhado" Height="2" Width="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="1" Background="{StaticResource Brand500Brush}"
                        Visibility="Hidden" IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
            <Grid>
                <!-- 0: GERAL -->
                <StackPanel x:Name="GeralPanel">
                    <TextBlock Text="Inicialização" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Iniciar com o Windows" FontSize="14"/>
                                    <TextBlock Text="Abre o SevenzinTwks automaticamente como Administrador ao entrar no Windows." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="SwInicio" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Inicio_Click"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderDefaultBrush}" Margin="0,6,0,6"/>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Iniciar minimizado na bandeja" FontSize="14"/>
                                    <TextBlock Text="Ao iniciar com o Windows, recolhe o aplicativo diretamente para a bandeja perto do relógio (Tray Icons)." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="SwInicioMinimizado" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="InicioMinimizado_Click"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderDefaultBrush}" Margin="0,6,0,6"/>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Login automático" FontSize="14"/>
                                    <TextBlock Text="Entra na conta automaticamente usando credenciais salvas sem travar na tela de login." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="SwLoginAuto" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="LoginAuto_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Comportamento do aplicativo" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Minimizar para a bandeja" FontSize="14"/>
                                    <TextBlock Text="Ao minimizar, recolhe o SevenzinTwks para a bandeja do sistema (perto do relógio). Clique no ícone para reabrir." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="SwMinBandeja" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Bandeja_Click"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderDefaultBrush}" Margin="0,6,0,6"/>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Fechar para a bandeja" FontSize="14"/>
                                    <TextBlock Text="O botão × mantém o aplicativo ativo na bandeja do sistema em segundo plano (use o menu do ícone para encerrar)." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="SwFecharBandeja" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Bandeja_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Proteção do sistema" Style="{StaticResource SectionLabel}" Margin="0,24,0,10"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Criar ponto de restauração antes de otimizar" FontSize="14"/>
                                    <TextBlock Text="Antes de &quot;Otimizar para jogos&quot;, do Auto NVIDIA Debloat e da restauração de timers de boot. Leva de 30 s a alguns minutos." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="SwPontoAntes" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Ponto_Click"
                                              AutomationProperties.Name="Criar ponto de restauração antes de otimizar"/>
                            </Grid>
                            <StackPanel x:Name="BloquearLinha">
                                <Border Height="1" Background="{StaticResource BorderDefaultBrush}" Margin="0,6,0,6"/>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Bloquear a otimização se o ponto falhar" FontSize="14"/>
                                        <TextBlock Text="Se o Windows não criar o ponto, a otimização só continua depois da sua confirmação explícita." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="SwBloquearSemPonto" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Ponto_Click"
                                                  AutomationProperties.Name="Bloquear a otimização se o ponto falhar"/>
                                </Grid>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource BorderDefaultBrush}" Margin="0,6,0,6"/>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <DockPanel>
                                        <Ellipse x:Name="PontoPonto" Width="8" Height="8" Margin="0,5,8,0" VerticalAlignment="Top" Fill="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="PontoStatus" Text="Lendo a Proteção do Sistema…" FontSize="13" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock x:Name="PontoAviso" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="16,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="PontoAgoraBtn" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Criar ponto agora" VerticalAlignment="Center" Click="PontoAgora_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="As alterações são salvas automaticamente." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="2,12,0,0"/>
                </StackPanel>

                <!-- 1: PREFERÊNCIAS -->
                <StackPanel x:Name="PrefPanel" Visibility="Collapsed">
                    <TextBlock Text="Assistente (opcional)" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Endpoint do assistente (HTTPS)" FontSize="14"/>
                            <TextBlock Text="Sem URL, o envio fica desligado. Com URL, cada mensagem é enviada apenas quando você aperta Enviar — nunca em segundo plano." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox x:Name="AssistenteTxt" Style="{StaticResource DarkBox}" Width="420" Tag="https://seu-endpoint/assistente" VerticalContentAlignment="Center"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Salvar" Margin="8,0,0,0" Click="AssistenteSalvar_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Limpar" Margin="8,0,0,0" Click="AssistenteLimpar_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="AssistenteStatus" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap"
                                       Text="Nenhum endpoint configurado."/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Dados e privacidade" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Pasta de dados local" FontSize="14"/>
                                <TextBlock x:Name="PastaTxt" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Backup/auditoria dos tweaks, perfis e relatórios. Nada sai do PC sem ação explícita sua." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Abrir pasta" VerticalAlignment="Center" Click="AbrirPasta_Click"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Sobre" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="VersaoTxt"/>
                            <TextBlock Text="Reconstrução segura, somente leitura por padrão, tudo reversível." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AtualizaStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                           Text="Verifica a release mais recente no GitHub. Nada é baixado sem você confirmar."/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AbrirReleaseBtn" Style="{StaticResource PrimaryButton}" Content="Baixar atualização"
                                            Visibility="Collapsed" Margin="0,0,8,0" Click="AbrirRelease_Click"/>
                                    <Button x:Name="VerificarBtn" Style="{StaticResource SecondaryButton}" Content="Buscar atualizações" Click="Verificar_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2: PERFIL -->
                <Border x:Name="PerfilPanel" Visibility="Collapsed">
                    <views:PerfilView/>
                </Border>

                <!-- 3: NOTIFICAÇÕES -->
                <Border x:Name="NotificacoesPanel" Visibility="Collapsed">
                    <views:NotificacoesView x:Name="NotificacoesSubView"/>
                </Border>

                <!-- 4: TELEMETRIA -->
                <Border x:Name="TelemetriaPanel" Visibility="Collapsed">
                    <views:TelemetriaView/>
                </Border>

                <!-- 5: BENCHMARK -->
                <Border x:Name="BenchmarkPanel" Visibility="Collapsed">
                    <views:BenchmarkView/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
