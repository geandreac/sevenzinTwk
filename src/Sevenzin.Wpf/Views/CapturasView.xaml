<UserControl x:Class="Sevenzin.Wpf.Views.CapturasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,8,0,12">
            <TextBlock Text="Capturas" Style="{StaticResource TituloTela}"/>
            <TextBlock Text="Captura de tela LOCAL, só sua. Salva numa pasta no seu PC e nunca é enviada a lugar nenhum — sem rede, sem webhook (ao contrário do original)." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="BtnCapturar" Style="{StaticResource PrimaryButton}" Content="Capturar tela" Click="Capturar_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Abrir pasta" Click="AbrirPasta_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusLbl" Foreground="{StaticResource TextMutedBrush}" Margin="2,12,0,0" TextWrapping="Wrap"
                       Text="Clique em Capturar tela. A janela do Sevenzin é minimizada por um instante para não aparecer na imagem."/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,16">
            <Grid>
                <TextBlock x:Name="Placeholder" Text="A última captura aparece aqui." Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="Thumb" Stretch="Uniform" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
