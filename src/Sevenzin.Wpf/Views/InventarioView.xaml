<UserControl x:Class="Sevenzin.Wpf.Views.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Inventário" Style="{StaticResource TituloTela}" Margin="0,8,0,2"/>
            <TextBlock Text="Somente leitura · origem e grau de confiança de cada dado, sem identificadores pessoais." Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,16" ClipToBounds="True">
            <DataGrid x:Name="Grade" Style="{StaticResource DarkGrid}">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" Padding="12,8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Brand400Brush}"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Nome}" Width="1.8*"/>
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="3*"/>
                    <DataGridTextColumn Header="Confiança" Binding="{Binding Tipo}" Width="1.1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Cor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Fonte" Binding="{Binding Fonte}" Width="1.4*"/>
                    <DataGridTextColumn Header="Observação" Binding="{Binding Obs}" Width="1.6*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
