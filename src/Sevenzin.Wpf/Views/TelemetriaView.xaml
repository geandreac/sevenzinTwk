<UserControl x:Class="Sevenzin.Wpf.Views.TelemetriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Telemetria" Style="{StaticResource TituloTela}" Margin="0,8,0,2"/>
            <TextBlock Text="Sessão iniciada e encerrada por você. Mede uma série temporal (CPU, clock, memória) e o próprio overhead. Sem gravar tela nem ler memória de outros apps." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Duração (s)" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                <TextBox x:Name="DurBox" Style="{StaticResource DarkBox}" Text="10" Width="56" Margin="0,0,16,0"/>
                <TextBlock Text="Intervalo (ms)" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                <TextBox x:Name="IntBox" Style="{StaticResource DarkBox}" Text="1000" Width="72" Margin="0,0,16,0"/>
                <Button x:Name="BtnMedir" Style="{StaticResource PrimaryButton}" Content="Iniciar medição" Click="Medir_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnBase" Style="{StaticResource SecondaryButton}" Content="Definir linha de base" Click="Base_Click" IsEnabled="False"/>
                <TextBlock x:Name="CapturaLbl" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8,8,8">
            <StackPanel>
                <TextBlock Text="SESSÃO ATUAL" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20" ClipToBounds="True">
                    <DataGrid x:Name="SumGrid" Style="{StaticResource DarkGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Métrica" Binding="{Binding Metrica}" Width="1.8*"/>
                            <DataGridTextColumn Header="Média" Binding="{Binding Media}" Width="*"/>
                            <DataGridTextColumn Header="p95" Binding="{Binding P95}" Width="0.8*"/>
                            <DataGridTextColumn Header="p99" Binding="{Binding P99}" Width="0.8*"/>
                            <DataGridTextColumn Header="Desvio" Binding="{Binding Desvio}" Width="0.8*"/>
                            <DataGridTextColumn Header="Faixa" Binding="{Binding Faixa}" Width="1.4*"/>
                            <DataGridTextColumn Header="Unidade" Binding="{Binding Unidade}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock x:Name="AbLbl" Text="COMPARAÇÃO A/B — nenhuma linha de base definida" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <DataGrid x:Name="AbGrid" Style="{StaticResource DarkGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Métrica" Binding="{Binding Metrica}" Width="1.6*"/>
                            <DataGridTextColumn Header="Base" Binding="{Binding Base}" Width="*"/>
                            <DataGridTextColumn Header="Atual" Binding="{Binding Atual}" Width="*"/>
                            <DataGridTextColumn Header="Δ" Binding="{Binding Delta}" Width="0.8*"/>
                            <DataGridTextColumn Header="Ruído" Binding="{Binding Ruido}" Width="0.8*"/>
                            <DataGridTextColumn Header="Veredito" Binding="{Binding Veredito}" Width="1.6*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Cor}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusLbl" Grid.Row="2" Foreground="{StaticResource TextMutedBrush}" Margin="2,10,0,12"
                   Text="Nenhuma medição ainda. Ajuste a duração e clique em Iniciar medição."/>
    </Grid>
</UserControl>
