<UserControl x:Class="Sevenzin.Wpf.Views.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,24,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Ajustes" Style="{StaticResource TituloTela}" Margin="0,8,0,8"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock x:Name="ResumoTxt" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="Contador" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBox x:Name="BuscaBox" Grid.Column="1" Width="280" Style="{StaticResource DarkBox}" Tag="Buscar ajuste" TextChanged="Busca_Changed"
                         VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.Name="Buscar ajuste"/>
            </Grid>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
            <Grid>
                <StackPanel x:Name="Lista"/>
                <TextBlock x:Name="SemResultado" Visibility="Collapsed" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,8,0,0"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
