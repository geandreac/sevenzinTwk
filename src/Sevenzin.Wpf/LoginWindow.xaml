<Window x:Class="Sevenzin.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sevenzin — Acesso" Height="620" Width="980" MinWidth="820" MinHeight="560"
        Icon="pack://application:,,,/Assets/sevenzin.ico"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}"
        FontFamily="{StaticResource UiFont}" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Controles da janela -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimizar"/>
            <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar"/>
        </StackPanel>

        <!-- Formulário -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Margin="24">
            <Viewbox Height="54" HorizontalAlignment="Center">
                <Path Data="{StaticResource ic_logo}" Fill="{StaticResource Brand500Brush}"/>
            </Viewbox>
            <TextBlock Text="SEVENZIN" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock Text="PC OPTIMIZER" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock x:Name="Subtitulo" Text="Acesse sua conta" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,22"/>

            <TextBlock Text="E-mail" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="Email" Style="{StaticResource DarkBox}" Height="40" Padding="10,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Senha" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,14,0,4"/>
            <Grid>
                <PasswordBox x:Name="Senha" Height="40" Padding="10,0,40,0" VerticalContentAlignment="Center"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" FontFamily="{StaticResource UiFont}"
                             CaretBrush="{StaticResource TextPrimaryBrush}" KeyDown="Campo_KeyDown"/>
                <TextBox x:Name="SenhaVisivel" Height="40" Padding="10,0,40,0" VerticalContentAlignment="Center" Visibility="Collapsed"
                         Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" FontFamily="{StaticResource UiFont}"
                         CaretBrush="{StaticResource TextPrimaryBrush}" KeyDown="Campo_KeyDown"/>
                <ToggleButton x:Name="OlhoBtn" Width="34" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                              Cursor="Hand" Click="Olho_Click" ToolTip="Mostrar/ocultar senha" Foreground="{StaticResource TextMutedBrush}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <TextBlock x:Name="glifo" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="glifo" Property="Text" Value="&#xE7B2;"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
            <TextBlock x:Name="SenhaAjuda" Text="mínimo 12 · maiúsc/minúsc, número e símbolo" Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>

            <!-- Confirmar senha (apenas no primeiro administrador) -->
            <StackPanel x:Name="ConfirmarBloco" Visibility="Collapsed">
                <TextBlock Text="Confirmar senha" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,14,0,4"/>
                <PasswordBox x:Name="Confirmar" Height="40" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" FontFamily="{StaticResource UiFont}"
                             CaretBrush="{StaticResource TextPrimaryBrush}" KeyDown="Campo_KeyDown"/>
            </StackPanel>

            <Grid x:Name="LinhaOpcoes" Margin="0,14,0,0">
                <CheckBox x:Name="Lembrar" Content="Lembrar de mim" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Hyperlink x:Name="EsqueciLink" Click="Esqueci_Click" Foreground="{StaticResource Brand400Brush}" TextDecorations="{x:Null}">Esqueci minha senha</Hyperlink>
                </TextBlock>
            </Grid>

            <Button x:Name="EntrarBtn" Style="{StaticResource PrimaryButton}" Content="Entrar" Height="44" Margin="0,20,0,0" Click="Entrar_Click"/>
            <TextBlock x:Name="Mensagem" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Painel decorativo (inspirado no Figma; arte de circuito simplificada) -->
        <Border Grid.Column="1" Margin="0,54,28,28" CornerRadius="16" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.45" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#FF0E2340" Offset="0"/>
                        <GradientStop Color="#FF070B13" Offset="1"/>
                    </RadialGradientBrush>
                </Grid.Background>
                <Viewbox Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9">
                    <Path Data="{StaticResource ic_logo}" Fill="{StaticResource Brand500Brush}"/>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</Window>
